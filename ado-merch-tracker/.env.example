# Upstash Redis (free tier) — from console.upstash.com after creating a Redis DB
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Resend (free tier) — from resend.com/api-keys
RESEND_API_KEY=
ALERT_EMAIL_TO=you@example.com
# Leave as-is until you verify your own domain in Resend:
ALERT_EMAIL_FROM=onboarding@resend.dev

# A random long string you make up yourself — protects /api/check from strangers
CRON_SECRET=

# Optional: change which collection is watched (defaults to all-merch)
# ADO_COLLECTION_PATH=/collections/all-merch
